root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.java]
indent_size = 4

[*.{kts,gradle}]
indent_size = 4

[*.ts]
quote_type = single

[*.{md,markdown}]
trim_trailing_whitespace = false
max_line_length = off

[*.bat]
end_of_line = crlf

[LICENSE]
trim_trailing_whitespace = false
