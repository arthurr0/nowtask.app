# Copy to .env and fill in. The .env file is ignored by git.

# --- Read by docker-compose.yml (local run) ---

# The fallback key for the MCP server. Usually leave it empty: agents connect at /mcp and bring
# their own key in the Authorization header, and you generate a key in the application (AI agents -> New key).
# Fill it in only when connecting a client that cannot send the header.
NOWTASK_API_KEY=

# Outgoing mail for mail integrations. Locally Mailpit catches it
# (docker-compose.yml), the inbox is at http://localhost:8025.

# --- Read by docker-compose.prod.yml (deployment) ---
# The database. The password is required, compose will not start without it.
# NOWTASK_DB_NAME=nowtask
# NOWTASK_DB_USER=nowtask
# NOWTASK_DB_PASSWORD=
# The account the application itself uses. It is not the table owner, so row level security applies
# to it. Flyway keeps using NOWTASK_DB_USER and creates this role on the first run of V44.
# NOWTASK_APP_DB_USER=nowtask_app
# NOWTASK_APP_DB_PASSWORD=
# The public address of the application. It goes into the links in invitation and verification mail.
# NOWTASK_APP_URL=https://nowtask.app
# Who may create an account: open, invite-only or sso-only.
# NOWTASK_SIGNUP_MODE=open
# IMAGE_TAG=latest
# Outgoing mail over SMTP. Example for Zoho Mail: a paid organisation sends through smtppro, a free
# one through smtp. The TLD follows the data centre, .eu for Europe (login at mail.zoho.eu) and .com
# for the global one, so the four options are smtppro.zoho.eu, smtppro.zoho.com, smtp.zoho.eu and
# smtp.zoho.com. The exact host is in Zoho under Settings -> Mail Accounts -> IMAP/SMTP.
# The username is the full mailbox address, the password is an app password generated in Zoho
# (Settings -> Security -> App passwords), never the account password.
# The from address must be a mailbox or a verified alias of that Zoho account.
# NOWTASK_MAIL_HOST=smtppro.zoho.eu
# NOWTASK_MAIL_PORT=587
# NOWTASK_MAIL_FROM=noreply@nowtask.app
# NOWTASK_MAIL_USERNAME=noreply@nowtask.app
# NOWTASK_MAIL_PASSWORD=
# Authentication and STARTTLS are on by default in docker-compose.prod.yml. Set them to false only
# for a relay without a login, such as a local Mailpit.
# NOWTASK_MAIL_AUTH=true
# NOWTASK_MAIL_STARTTLS=true
# The sender name shown next to the address, and an optional address for replies.
# NOWTASK_MAIL_FROM_NAME=nowtask
# NOWTASK_MAIL_REPLY_TO=
# NOWTASK_MCP_ALLOWED_HOSTS=mcp:8765
# NOWTASK_FRONTEND_PORT=8080
# NOWTASK_BACKEND_PORT=8081
# NOWTASK_MCP_PORT=8765
